{
  "name": "dsh-topic-graph",
  "version": "0.6.42",
  "description": "会话话题图谱：按轮次切分会话，AI 增量聚合为话题与阶段，提供工作流 / 时间线 / 结构图三种视图，展示每个话题/轮次的 token 消耗、工具调用与 Agent 耗时占比。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "meta": {
    "title": {
      "en": "Topic Graph",
      "zh": "话题图谱（Topic Graph）"
    },
    "description": {
      "en": "Segment sessions by turn, let AI incrementally cluster turns into topics and stages, with workflow / timeline / structure graph views plus token, tool and agent-time shares.",
      "zh": "按轮次切分会话，由 AI 增量聚合为话题与阶段，提供工作流 / 时间线 / 结构图三种视图，展示 token、工具调用与 Agent 耗时占比。"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "topic",
    "graph",
    "turn",
    "token-usage"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2+": "compatible"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hagen666/dsh-topic-graph.git"
  }
}
